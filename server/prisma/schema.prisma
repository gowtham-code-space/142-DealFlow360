// Prisma Schema for DealFlow360 Q2C Lifecycle Platform
// Provider: MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES_REP
  SALES_MANAGER
  OPERATIONS
  CUSTOMER
}

enum Tier {
  STANDARD
  GOLD
  PLATINUM
}

enum BillingType {
  ONE_TIME
  RECURRING_MONTHLY
  RECURRING_ANNUAL
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CUSTOMER_NEGOTIATION
  CUSTOMER_ACCEPTED
  FULFILLED
  INVOICED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum AllocationStatus {
  PENDING
  ALLOCATED
  DISPATCHED
  DELIVERED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  name         String
  role         Role          @default(SALES_REP)
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id])
  quotations   Quotation[]   @relation("RepQuotations")
  approvals    Approval[]
  negotiations Negotiation[]
  auditLogs    AuditLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

model Customer {
  id           String        @id @default(uuid())
  name         String
  tier         Tier          @default(STANDARD)
  creditLimit  Decimal       @default(50000.00) @db.Decimal(12, 2)
  riskScore    Int           @default(20)
  contactEmail String
  paymentTerms String        @default("Net-30")
  users        User[]
  quotations   Quotation[]
  invoices     Invoice[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("customers")
}

model Product {
  id             String          @id @default(uuid())
  sku            String          @unique
  name           String
  description    String?         @db.Text
  category       String
  listPrice      Decimal         @db.Decimal(12, 2)
  costPrice      Decimal         @db.Decimal(12, 2)
  minMargin      Decimal         @default(20.00) @db.Decimal(5, 2)
  billingType    BillingType     @default(ONE_TIME)
  isUpsell       Boolean         @default(false)
  quotationItems QuotationItem[]
  inventories    Inventory[]
  allocations    Allocation[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("products")
}

model Quotation {
  id                     String          @id @default(uuid())
  quotationNumber        String          @unique
  customerId             String
  customer               Customer        @relation(fields: [customerId], references: [id])
  repId                  String
  rep                    User            @relation("RepQuotations", fields: [repId], references: [id])
  status                 QuoteStatus     @default(DRAFT)
  totalListPrice         Decimal         @default(0.00) @db.Decimal(12, 2)
  totalDiscountAmount    Decimal         @default(0.00) @db.Decimal(12, 2)
  finalTotal             Decimal         @default(0.00) @db.Decimal(12, 2)
  cogs                   Decimal         @default(0.00) @db.Decimal(12, 2)
  grossMarginPercent     Decimal         @default(0.00) @db.Decimal(5, 2)
  requiresApproval       Boolean         @default(false)
  approvalReason         String?         @db.Text
  items                  QuotationItem[]
  approvals              Approval[]
  allocations            Allocation[]
  invoices               Invoice[]
  negotiations           Negotiation[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@map("quotations")
}

model QuotationItem {
  id              String      @id @default(uuid())
  quotationId     String
  quotation       Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId       String
  product         Product     @relation(fields: [productId], references: [id])
  quantity        Int         @default(1)
  unitListPrice   Decimal     @db.Decimal(12, 2)
  unitCostPrice   Decimal     @db.Decimal(12, 2)
  discountPercent Decimal     @default(0.00) @db.Decimal(5, 2)
  netTotal        Decimal     @db.Decimal(12, 2)
  marginPercent   Decimal     @db.Decimal(5, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("quotation_items")
}

model Approval {
  id          String      @id @default(uuid())
  quotationId String
  quotation   Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  approverId  String
  approver    User        @relation(fields: [approverId], references: [id])
  status      QuoteStatus @default(PENDING_APPROVAL)
  comments    String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("approvals")
}

model Warehouse {
  id                 String       @id @default(uuid())
  code               String       @unique
  name               String
  location           String
  shippingMultiplier Decimal      @default(1.00) @db.Decimal(4, 2)
  inventories        Inventory[]
  allocations        Allocation[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("warehouses")
}

model Inventory {
  id                String    @id @default(uuid())
  warehouseId       String
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  quantityAvailable Int       @default(0)
  quantityReserved  Int       @default(0)
  updatedAt         DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@map("inventories")
}

model Allocation {
  id           String           @id @default(uuid())
  quotationId  String
  quotation    Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  warehouseId  String
  warehouse    Warehouse        @relation(fields: [warehouseId], references: [id])
  productId    String
  product      Product          @relation(fields: [productId], references: [id])
  quantity     Int
  shippingCost Decimal          @default(0.00) @db.Decimal(10, 2)
  status       AllocationStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("allocations")
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  quotationId    String
  quotation      Quotation     @relation(fields: [quotationId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  oneTimeTotal   Decimal       @default(0.00) @db.Decimal(12, 2)
  recurringTotal Decimal       @default(0.00) @db.Decimal(12, 2)
  billingCycle   String?
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("invoices")
}

model Negotiation {
  id               String    @id @default(uuid())
  quotationId      String
  quotation        Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User      @relation(fields: [senderId], references: [id])
  senderRole       Role
  message          String    @db.Text
  proposedDiscount Decimal?  @db.Decimal(5, 2)
  createdAt        DateTime  @default(now())

  @@map("negotiations")
}

model AuditLog {
  id            String   @id @default(uuid())
  entityType    String
  entityId      String
  action        String
  performedById String
  performedBy   User     @relation(fields: [performedById], references: [id])
  details       String?  @db.Text
  createdAt     DateTime @default(now())

  @@map("audit_logs")
}
